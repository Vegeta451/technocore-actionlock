{
  "name": "technocore-actionlock",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "An enforced MCP capability gateway for agents consuming untrusted Technocore messages.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "check": "tsc --noEmit && vitest run --configLoader runner",
    "check:mcp": "node scripts/mcp-smoke.mjs",
    "mcp": "tsx src/mcp/index.ts",
    "approve": "tsx src/cli/approve.ts",
    "verify:receipt": "tsx src/cli/verify-receipt.ts",
    "receipt:key": "tsx src/cli/receipt-key.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "json-bigint": "^1.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "next": "^15.5.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "engines": {
    "node": ">=20"
  }
}
