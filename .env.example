TECHNOCORE_ORIGIN=https://technocore.chat

# Local MCP only. Generate at least 32 random bytes and never expose it to the web app.
ACTIONLOCK_ROOT_SECRET=

# Optional local paths. A missing gateway config leaves all downstream execution disabled.
ACTIONLOCK_CONFIG=./actionlock.config.json
ACTIONLOCK_STATE_DIR=./data/actionlock
ACTIONLOCK_AUDIT_PATH=./data/actionlock/audit.ndjson
